{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ordensimple",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "ordensimple-sin-correos",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "RESEND_API_KEY": ""
      },
      "port": 3000
    },
    {
      "name": "ordensimple-cobros-prueba",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "RESEND_API_KEY": "",
        "BILLING_ENABLED": "true"
      },
      "port": 3000
    },
    {
      "name": "ordensimple-con-planes",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "RESEND_API_KEY": "",
        "ENFORCE_PLANS": "true"
      },
      "port": 3000
    }
  ]
