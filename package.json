{
  "name": "ordensimple",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:licencias": "node --env-file=.env --conditions=react-server --import tsx --test tests/licencias.test.ts",
    "test:medidas": "node --conditions=react-server --import tsx --test tests/medidas.test.ts",
    "test:tarjetas": "node --conditions=react-server --import tsx --test tests/tarjetas.test.ts",
    "test:links": "node --conditions=react-server --import tsx --test tests/links.test.ts",
    "test:planes": "node --conditions=react-server --import tsx --test tests/planes.test.ts",
    "postinstall": "prisma generate && node scripts/copy-wasm.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:local": "prisma dev -d -n ordensimple",
    "vercel-build": "prisma migrate deploy && next build"
  },
  "dependencies": {
    "@csstools/postcss-cascade-layers": "^6.0.2",
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.0.0",
    "barcode-detector": "^3.2.2",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "gsap": "^3.15.1",
    "heic-to": "1.6.6",
    "lenis": "^1.3.27",
    "lucide-react": "^1.50.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
