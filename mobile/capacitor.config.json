{
  "appId": "cl.ordensimple.app",
  "appName": "OrdenSimple",
  "webDir": "www",
  "server": {
    "url": "https://www.ordensimple.cl/dashboard",
    "allowNavigation": [
      "www.ordensimple.cl",
      "ordensimple.cl"
    ]
  },
  "ios": {
    "appendUserAgent": "OrdenSimpleApp",
    "contentInset": "never",
    "scheme": "OrdenSimple",
    "includePlugins": [
      "@capacitor-community/bluetooth-le",
      "capacitor-tcp-socket"
    ]
  },
  "android": {
    "appendUserAgent": "OrdenSimpleApp"
  },
  "plugins": {
    "BluetoothLe": {
      "displayStrings": {
        "scanning": "Buscando impresoras...",
        "cancel": "Cancelar",
        "availableDevices": "Impresoras cercanas",
        "noDeviceFound": "No se encontró ninguna impresora"
      }
    }
  }
}
