{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ordensimple",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "ordensimple-sin-correos",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "RESEND_API_KEY": ""
      },
      "port": 3000
    },
    {
      "name": "ordensimple-cobros-prueba",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "RESEND_API_KEY": "",
        "BILLING_ENABLED": "true"
      },
      "port": 3000
    },
    {
      "name": "ordensimple-con-planes",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "RESEND_API_KEY": "",
        "ENFORCE_PLANS": "true"
      },
      "port": 3000
    },
    {
      "name": "ordensimple-produccion-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "env": {
        "RESEND_API_KEY": ""
      },
      "port": 3100
    },
    {
      "name": "ordensimple-mp-simulado",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "RESEND_API_KEY": "",
        "ENFORCE_PLANS": "true",
        "MERCADOPAGO_CLIENT_ID": "simulado",
        "MERCADOPAGO_CLIENT_SECRET": "simulado",
        "MERCADOPAGO_API_URL": "http://localhost:4010",
        "MERCADOPAGO_AUTH_URL": "http://localhost:4010"
      },
      "port": 3000
    }
  ]
}
