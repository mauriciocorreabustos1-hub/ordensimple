// OrdenSimple — modelo de datos
// Montos: enteros en la unidad mínima de la moneda (CLP = pesos, USD = centavos).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  TRANSFER
  OTHER
  // Venta a crédito informal ("fiado"): el cliente paga después.
  FIADO
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  /// Merma: vencido, dañado, perdido o consumo propio (se valoriza al costo).
  WASTE
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  NO_SALES
  TIP
  SYSTEM
}

// ─── Autenticación (Better Auth) ────────────────────────────────────────────

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  activeBusinessId String?
  // Aceptación de términos (fecha) y consentimiento para recibir promociones.
  termsAcceptedAt  DateTime?
  marketingOptIn   Boolean   @default(false)
  /// Correos de bienvenida enviados (1, 2, 3). 99 = no quiere recibirlos.
  nudgeStep        Int       @default(0)
  /// Última vez que usó la app (se actualiza como máximo cada 5 minutos).
  lastActiveAt     DateTime?
  /// De dónde llegó al registrarse (enlace del anuncio: utm_source, utm_medium, utm_campaign) o la página que lo trajo.
  signupSource     String?
  signupMedium     String?
  signupCampaign   String?
  signupReferrer   String?
  /// Cuándo se le mandó el recordatorio de confirmar el correo (se manda una sola vez).
  verifyRemindedAt DateTime?
  /// Código del negocio que lo invitó ("Invita a un amigo"), si llegó por un enlace de invitación.
  invitedByCode    String?
  /// Verificación en dos pasos (Better Auth): activada y con qué método ("email" o "app").
  twoFactorEnabled Boolean   @default(false)
  twoFactorMethod  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  twoFactors    TwoFactor[]
  memberships   BusinessMember[]
  sales         Sale[]
  expenses      Expense[]
  movements     InventoryMovement[]
  notifications Notification[]
  adminNotes    AdminNote[]
  photo         UserPhoto?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Negocio ────────────────────────────────────────────────────────────────

model Business {
  id                  String    @id @default(cuid())
  name                String
  type                String?
  country             String    @default("CL")
  currency            String    @default("CLP")
  timezone            String    @default("America/Santiago")
  plan                Plan      @default(FREE)
  /// Hasta cuándo dura el plan pagado o regalado. null = no vence.
  planExpiresAt       DateTime?
  /// Descuento ganado con un código, para aplicarlo cuando se cobre la suscripción.
  /// Cupos regalados por el admin, que se suman a los del plan.
  extraProducts       Int       @default(0)
  extraMembers        Int       @default(0)
  discountPercent     Int?
  discountCode        String?
  hasProducts         Boolean?
  hasEmployees        Boolean?
  managesInventory    Boolean?
  monthlyRevenueRange String?
  onboardingCompleted Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  members           BusinessMember[]
  settings          BusinessSettings?
  categories        Category[]
  products          Product[]
  sales             Sale[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  customers         Customer[]
  suppliers         Supplier[]
  movements         InventoryMovement[]
  goals             Goal[]
  customerPayments  CustomerPayment[]
  cashClosings      CashClosing[]
  notifications     Notification[]
  couponRedemptions CouponRedemption[]
  invitations       Invitation[]
  subscriptions     Subscription[]
  referralsMade     Referral[]          @relation("ReferralReferrer")
  referredBy        Referral?           @relation("ReferralReferred")
  specialLinkUses   SpecialLinkUse[]
  payables          Payable[]
  productBarcodes   ProductBarcode[]
  featureUsage      FeatureUsage[]
  ownerWithdrawals  OwnerWithdrawal[]
  loans             Loan[]
  balanceSnapshots  BalanceSnapshot[]
  logo              BusinessLogo?
  /// Cuándo se cambió el logo (null = sin logo). Sirve para saber si hay y para que el navegador no muestre uno viejo.
  logoUpdatedAt     DateTime?
  /// Código para el enlace "Invita a un amigo" (se crea la primera vez que se abre esa página).
  referralCode      String?             @unique

  @@map("business")
}

model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @default(EMPLOYEE)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_member")
}

model BusinessSettings {
  id                    String        @id @default(cuid())
  businessId            String        @unique
  business              Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  easyMode              Boolean       @default(false)
  lowStockAlerts        Boolean       @default(true)
  noSalesReminder       Boolean       @default(true)
  weeklySummary         Boolean       @default(true)
  defaultPayment        PaymentMethod @default(CASH)
  /// El negocio cobra IVA en sus ventas (inscrito en el SII): se calcula el IVA a pagar y los montos sin IVA.
  /// Viene activado; quien no cobra IVA lo desactiva en Configuración.
  chargesVat            Boolean       @default(true)
  /// Día del mes siguiente en que vence el pago del IVA (en Chile, F29: día 20 con documentos electrónicos, si no día 12).
  vatDueDay             Int           @default(20)
  /// Tasa del pago provisional mensual (PPM) que va en el mismo F29, sobre las ventas sin IVA. 0 = no mostrarlo.
  /// Pro Pyme General 0,125% (rebaja transitoria 2025-2027, Ley 21.755); Pro Pyme Transparente 0,2%.
  ppmRate               Float         @default(0.00125)
  /// Lo que el dueño quiere sacar al mes como su sueldo (para avisar si se pasa). Null = sin meta.
  ownerSalary           Int?
  /// Plata en caja y banco que el dueño declaró, y cuándo: desde ahí el balance la sigue sola.
  openingCash           Int?
  openingCashAt         DateTime?
  /// Últimos avisos enviados por correo (para no repetirlos).
  lastWeeklySummaryAt   DateTime?
  lastNoSalesReminderAt DateTime?
  lastLowStockAlertAt   DateTime?
  /// Productos incluidos en el último aviso de stock bajo: si no cambian, no se repite el correo.
  lowStockAlertKey      String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("business_settings")
}

// ─── Catálogo ───────────────────────────────────────────────────────────────

model Category {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, name])
  @@map("category")
}

model Product {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  sku        String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cost       Int       @default(0)
  price      Int       @default(0)
  stock      Int       @default(0)
  minStock   Int       @default(0)
  trackStock Boolean   @default(true)
  /// Próximo vencimiento del stock (para avisar lo que está por vencer).
  expiresAt  DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  saleItems SaleItem[]
  movements InventoryMovement[]
  /// Códigos de barras adicionales (el principal es `sku`).
  barcodes  ProductBarcode[]

  @@unique([businessId, sku])
  @@index([businessId, active])
  @@index([categoryId])
  @@map("product")
}

// ─── Ventas ─────────────────────────────────────────────────────────────────

model Sale {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date          DateTime      @default(now())
  total         Int
  paymentMethod PaymentMethod @default(CASH)
  isQuick       Boolean       @default(false)
  note          String?
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  /// Id que pone el teléfono: si la venta se guardó sin internet y se reintenta, no se duplica.
  clientId      String?

  items     SaleItem[]
  movements InventoryMovement[]

  @@unique([businessId, clientId])
  @@index([businessId, date])
  @@index([customerId])
  @@map("sale")
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Int
  unitPrice   Int
  unitCost    Int      @default(0)
  subtotal    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
  @@map("sale_item")
}

// ─── Gastos ─────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  icon       String?
  isDefault  Boolean   @default(false)
  // Gasto que crece con las ventas (compra de mercadería). El resto se trata como gasto fijo.
  isVariable Boolean   @default(false)
  expenses   Expense[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, name])
  @@map("expense_category")
}

model Expense {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  description String
  amount      Int
  /// Tiene factura a nombre del negocio: su IVA se descuenta del IVA a pagar.
  hasInvoice  Boolean          @default(false)
  date        DateTime         @default(now())
  categoryId  String?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId  String?
  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([businessId, date])
  @@index([supplierId])
  @@index([categoryId])
  @@map("expense")
}

// ─── Contactos ──────────────────────────────────────────────────────────────

model Customer {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  notes      String?
  sales      Sale[]
  payments   CustomerPayment[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([businessId])
  @@map("customer")
}

model Supplier {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  email        String?
  products     String?
  deliveryCost Int?
  notes        String?
  expenses     Expense[]
  payables     Payable[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([businessId])
  @@map("supplier")
}

// ─── Inventario ─────────────────────────────────────────────────────────────

model InventoryMovement {
  id          String                @id @default(cuid())
  businessId  String
  business    Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId   String
  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        InventoryMovementType
  // Positivo suma stock, negativo resta.
  quantity    Int
  /// Costo unitario del producto al momento del movimiento (para valorizar la merma).
  unitCost    Int                   @default(0)
  reason      String?
  saleId      String?
  sale        Sale?                 @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([businessId, productId])
  @@index([saleId])
  @@index([productId])
  @@map("inventory_movement")
}

// ─── Metas y notificaciones ─────────────────────────────────────────────────

model Goal {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Mes de la meta en formato AAAA-MM, en la zona horaria del negocio.
  month        String
  targetProfit Int
  marginPct    Float?
  fixedCosts   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, month])
  @@map("goal")
}

model Notification {
  id         String           @id @default(cuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([businessId, readAt])
  @@map("notification")
}

// ─── Límite de intentos (Better Auth) ───────────────────────────────────────
// Se guarda en la base de datos para que funcione aunque Vercel use varias copias del servidor.

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ─── Fiado: abonos de clientes ──────────────────────────────────────────────
// Saldo de un cliente = ventas FIADO − abonos.

model CustomerPayment {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount        Int
  date          DateTime      @default(now())
  paymentMethod PaymentMethod @default(CASH)
  note          String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([businessId, date])
  @@index([customerId])
  @@map("customer_payment")
}

// ─── Cierre de caja ─────────────────────────────────────────────────────────

model CashClosing {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Día del cierre (AAAA-MM-DD) en la zona horaria del negocio.
  day         String
  opening     Int
  cashSales   Int
  cashIn      Int
  cashOut     Int
  expected    Int
  counted     Int
  difference  Int
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, day])
  @@map("cash_closing")
}

// ─── Registro de errores (se ve en /admin) ──────────────────────────────────

model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  digest    String?
  path      String?
  method    String?
  stack     String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("error_log")
}

// ─── Códigos de descuento (los crea el administrador en /admin) ─────────────

enum CouponKind {
  FREE_DAYS // Regala días de un plan
  PERCENT // Descuento porcentual en la suscripción
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  kind           CouponKind
  plan           Plan       @default(PRO)
  days           Int?
  percentOff     Int?
  maxRedemptions Int?
  expiresAt      DateTime?
  active         Boolean    @default(true)
  note           String?
  createdBy      String?
  createdAt      DateTime   @default(now())

  redemptions CouponRedemption[]

  @@map("coupon")
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  createdAt  DateTime @default(now())

  @@unique([couponId, businessId])
  @@index([businessId])
  @@map("coupon_redemption")
}

// ─── Correos de promoción (los envía el administrador en /admin) ─────────────

model EmailCampaign {
  id          String    @id @default(cuid())
  subject     String
  body        String
  buttonLabel String?
  buttonUrl   String?
  couponCode  String?
  /// ALL, FREE, PAID o DIRECT (personas específicas).
  audience    String    @default("ALL")
  recipients  Int       @default(0)
  /// En los envíos a personas específicas: sus correos, separados por coma.
  toEmails    String?
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  createdBy   String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  @@map("email_campaign")
}

// ─── Invitaciones al equipo de un negocio ───────────────────────────────────

model Invitation {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email       String
  role        Role      @default(EMPLOYEE)
  token       String    @unique
  invitedById String?
  /// Invitaciones enviadas juntas (una por sucursal): se aceptan todas con un solo enlace.
  batchId     String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId])
  @@index([email])
  @@index([batchId])
  @@map("invitation")
}

// ─── Suscripciones pagadas (Mercado Pago) ──────────────────────────────────

model Subscription {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Quién se suscribió.
  userId          String?
  plan            Plan      @default(PRO)
  provider        String    @default("MERCADOPAGO")
  /// Id de la suscripción en Mercado Pago (preapproval).
  externalId      String    @unique
  /// pending, authorized, paused o cancelled (como los informa Mercado Pago).
  status          String
  /// Monto mensual, en la unidad mínima de la moneda.
  amount          Int
  currency        String    @default("CLP")
  payerEmail      String
  /// Enlace para completar el pago mientras está pendiente.
  checkoutUrl     String?
  lastChargedAt   DateTime?
  nextPaymentAt   DateTime?
  /// "Invita a un amigo": el cobro está pausado como regalo y se reanuda solo en esta fecha.
  giftPausedUntil DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([businessId])
  @@map("subscription")
}

// ─── Pagos pendientes a proveedores (cuentas por pagar) ─────────────────────

model Payable {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  description String
  amount      Int
  /// Hasta cuándo hay que pagar.
  dueDate     DateTime
  /// Es una factura a nombre del negocio: su IVA se descuenta en el mes de la factura (no en el del pago).
  hasInvoice  Boolean   @default(true)
  /// Fecha de la factura. Al pagarla, el gasto queda en esta fecha.
  invoiceDate DateTime?
  /// Cuándo se pagó (se registra también como gasto).
  paidAt      DateTime?
  expenseId   String?
  /// Último recordatorio enviado por correo (para no repetirlo el mismo día).
  remindedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId, paidAt, dueDate])
  @@index([supplierId])
  @@map("payable")
}

// ─── Varios códigos de barras para un mismo producto ───────────────────────

model ProductBarcode {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  code       String
  createdAt  DateTime @default(now())

  @@unique([businessId, code])
  @@index([productId])
  @@map("product_barcode")
}

/// Notas internas del administrador sobre un usuario (solo las ve el admin).
model AdminNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Correo del administrador que la escribió.
  author    String
  text      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("admin_note")
}

/// Uso de funciones que no dejan registro propio (ver flujo de caja, escanear…): una fila por negocio, función y día.
model FeatureUsage {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  feature    String
  /// Día "AAAA-MM-DD" en la zona horaria del negocio.
  day        String
  count      Int      @default(1)

  @@id([businessId, feature, day])
  @@index([feature, day])
  @@map("feature_usage")
}

/// Plata o productos que el dueño saca del negocio para él. No es un gasto: no baja la utilidad.
model OwnerWithdrawal {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Monto en plata; si son productos, lo que costaron.
  amount      Int
  date        DateTime
  /// De dónde salió la plata: CASH (caja) o BANK (banco). Los productos salen del stock.
  source      String   @default("CASH")
  /// MONEY (saca plata), GOODS (saca productos) o DEPOSIT (pone plata en el negocio: ahorros, un préstamo, sencillo).
  kind        String   @default("MONEY")
  productId   String?
  quantity    Int?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([businessId, date])
  @@map("owner_withdrawal")
}

/// Préstamos y deudas del negocio (banco, tarjeta, familiares): lo que se debe hoy.
model Loan {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lender      String
  /// Lo que se debe hoy.
  balance     Int
  /// Cuota mensual (opcional) y día del mes en que se paga.
  installment Int?
  dueDay      Int?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
  @@map("loan")
}

/// Foto del balance de cada mes (la última vez que se miró ese mes), para ver cómo cambia.
model BalanceSnapshot {
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// "AAAA-MM"
  month       String
  assets      Int
  liabilities Int
  updatedAt   DateTime @updatedAt

  @@id([businessId, month])
  @@map("balance_snapshot")
}

/// Logo del negocio, ya achicado en el navegador (máximo 256 px). Va aparte para no cargarlo con cada consulta del negocio.
model BusinessLogo {
  businessId String   @id
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  data       Bytes
  type       String
  updatedAt  DateTime @updatedAt

  @@map("business_logo")
}

/// Foto de perfil, ya achicada en el navegador (máximo 256 px). User.image guarda su dirección.
model UserPhoto {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  type      String
  updatedAt DateTime @updatedAt

  @@map("user_photo")
}

// ─── Invita a un amigo ──────────────────────────────────────────────────────

/// Reglas del programa (una sola fila, id "default"); se cambian en /admin.
model ReferralProgram {
  id              String   @id @default("default")
  enabled         Boolean  @default(true)
  /// Plan que se regala.
  plan            Plan     @default(PRO)
  /// Días para quien llega invitado (al crear su negocio).
  invitedDays     Int      @default(14)
  /// Días para quien invita.
  referrerDays    Int      @default(30)
  /// Cuándo gana quien invita: REGISTRO (al crear el negocio), VENTAS (al registrar minSales ventas) o PAGO (al pagar su primer mes).
  referrerTrigger String   @default("VENTAS")
  minSales        Int      @default(5)
  /// Máximo de recompensas por negocio que invita (vacío = sin límite).
  maxRewards      Int?     @default(12)
  updatedAt       DateTime @updatedAt

  @@map("referral_program")
}

/// Un negocio que llegó invitado por otro.
model Referral {
  id                 String    @id @default(cuid())
  referrerBusinessId String
  referrer           Business  @relation("ReferralReferrer", fields: [referrerBusinessId], references: [id], onDelete: Cascade)
  referredBusinessId String    @unique
  referred           Business  @relation("ReferralReferred", fields: [referredBusinessId], references: [id], onDelete: Cascade)
  referredUserId     String?
  /// Días que recibió el invitado (0 si no se pudo aplicar) y por qué.
  invitedDays        Int       @default(0)
  invitedNote        String?
  /// Cuándo ganó quien invitó, cuántos días y una nota (por ejemplo, si ya tenía un plan mayor).
  referrerRewardedAt DateTime?
  referrerDays       Int?
  referrerNote       String?
  createdAt          DateTime  @default(now())

  @@index([referrerBusinessId])
  @@map("referral")
}

/// Enlace especial que crea el administrador para una campaña (anuncios, ferias, un contador aliado...):
/// ordensimple.cl/amigo/<code>. Quien se registra con él recibe días de regalo al crear su negocio.
model SpecialLink {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  plan      Plan             @default(PRO)
  days      Int              @default(14)
  expiresAt DateTime?
  maxUses   Int?
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  uses      SpecialLinkUse[]

  @@map("special_link")
}

/// Un negocio que se creó con un enlace especial.
model SpecialLinkUse {
  id         String      @id @default(cuid())
  linkId     String
  link       SpecialLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  /// Días que recibió (0 si no se pudo aplicar) y por qué.
  days       Int         @default(0)
  note       String?
  createdAt  DateTime    @default(now())

  @@unique([linkId, businessId])
  @@index([businessId])
  @@map("special_link_use")
}

/// Datos del segundo paso al iniciar sesión (app de códigos y códigos de respaldo). Lo maneja Better Auth.
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

/// Administradores agregados desde el panel (además de los de ADMIN_EMAILS en Vercel, que son los dueños).
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  addedBy   String?
  createdAt DateTime @default(now())

  @@map("admin_user")
}
