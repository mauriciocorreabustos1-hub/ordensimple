# Base de datos PostgreSQL
# Local sin Docker: npx prisma dev -d -n ordensimple  (te muestra la URL)
# Producción: Neon, Supabase, Prisma Postgres, Railway, etc.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/ordensimple"

# Better Auth — genera el secreto con: npx @better-auth/cli secret  (o cualquier cadena aleatoria de 32+ bytes)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Correo (opcional). Sin RESEND_API_KEY los enlaces de recuperación se imprimen en la consola del servidor.
RESEND_API_KEY=""
EMAIL_FROM="OrdenSimple <no-responder@tudominio.cl>"

# Correos con acceso al panel /admin, separados por coma
ADMIN_EMAILS=""
