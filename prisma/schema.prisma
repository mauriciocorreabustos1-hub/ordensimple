// OrdenSimple — modelo de datos
// Montos: enteros en la unidad mínima de la moneda (CLP = pesos, USD = centavos).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  TRANSFER
  OTHER
  // Venta a crédito informal ("fiado"): el cliente paga después.
  FIADO
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  /// Merma: vencido, dañado, perdido o consumo propio (se valoriza al costo).
  WASTE
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  NO_SALES
  TIP
  SYSTEM
}

// ─── Autenticación (Better Auth) ────────────────────────────────────────────

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  activeBusinessId String?
  // Aceptación de términos (fecha) y consentimiento para recibir promociones.
  termsAcceptedAt  DateTime?
  marketingOptIn   Boolean   @default(false)
  /// Correos de bienvenida enviados (1, 2, 3). 99 = no quiere recibirlos.
  nudgeStep        Int       @default(0)
  /// Última vez que usó la app (se actualiza como máximo cada 5 minutos).
  lastActiveAt     DateTime?
  /// De dónde llegó al registrarse (enlace del anuncio: utm_source, utm_medium, utm_campaign) o la página que lo trajo.
  signupSource     String?
  signupMedium     String?
  signupCampaign   String?
  signupReferrer   String?
  /// Cuándo se le mandó el recordatorio de confirmar el correo (se manda una sola vez).
  verifyRemindedAt DateTime?
  /// Código del negocio que lo invitó ("Invita a un amigo"), si llegó por un enlace de invitación.
  invitedByCode    String?
  /// Verificación en dos pasos (Better Auth): activada y con qué método ("email" o "app").
  twoFactorEnabled Boolean   @default(false)
  twoFactorMethod  String?
  /// Cuándo vio el tutorial de bienvenida (null = todavía no; se muestra al entrar a la app).
  welcomeTourAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions             Session[]
  accounts             Account[]
  twoFactors           TwoFactor[]
  memberships          BusinessMember[]
  pushSubscriptions    PushSubscription[]
  appointmentsAttended Appointment[]       @relation("AppointmentStaff")
  shiftsOpened         CashShift[]         @relation("ShiftOpenedBy")
  shiftsClosed         CashShift[]         @relation("ShiftClosedBy")
  sales                Sale[]
  expenses             Expense[]
  movements            InventoryMovement[]
  notifications        Notification[]
  adminNotes           AdminNote[]
  photo                UserPhoto?
  contactCard          ContactCard?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Negocio ────────────────────────────────────────────────────────────────

model Business {
  id                  String    @id @default(cuid())
  name                String
  type                String?
  country             String    @default("CL")
  currency            String    @default("CLP")
  timezone            String    @default("America/Santiago")
  plan                Plan      @default(FREE)
  /// Hasta cuándo dura el plan pagado o regalado. null = no vence.
  planExpiresAt       DateTime?
  /// Descuento ganado con un código, para aplicarlo cuando se cobre la suscripción.
  /// Cupos regalados por el admin, que se suman a los del plan.
  extraProducts       Int       @default(0)
  extraMembers        Int       @default(0)
  /// Código de activación que dejó este negocio en Pro permanente (si se anula el código, vuelve a Gratis).
  licenseCodeId       String?
  discountPercent     Int?
  discountCode        String?
  hasProducts         Boolean?
  hasEmployees        Boolean?
  managesInventory    Boolean?
  monthlyRevenueRange String?
  onboardingCompleted Boolean   @default(false)
  /// Tienda online: catálogo público en /tienda/<storeSlug> con pedidos por WhatsApp (plan Pro).
  storeEnabled        Boolean   @default(false)
  storeSlug           String?   @unique
  /// Direcciones que tuvo antes: nadie más las puede tomar y los enlaces viejos llevan a la nueva.
  storeOldSlugs       String[]  @default([])
  storeWhatsapp       String?
  storeMessage        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  members           BusinessMember[]
  settings          BusinessSettings?
  categories        Category[]
  products          Product[]
  sales             Sale[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  customers         Customer[]
  suppliers         Supplier[]
  movements         InventoryMovement[]
  goals             Goal[]
  customerPayments  CustomerPayment[]
  cashClosings      CashClosing[]
  cashShifts        CashShift[]
  webOrders         WebOrder[]
  quotes            Quote[]
  loyaltyCards      LoyaltyCard[]
  mpAccount         MercadoPagoAccount?
  onlinePayments    OnlinePayment[]
  paymentLinks      PaymentLink[]
  promotions        Promotion[]
  storeCoupons      StoreCoupon[]
  appointments      Appointment[]
  notifications     Notification[]
  couponRedemptions CouponRedemption[]
  invitations       Invitation[]
  subscriptions     Subscription[]
  contactCards      ContactCard[]
  referralsMade     Referral[]               @relation("ReferralReferrer")
  referredBy        Referral?                @relation("ReferralReferred")
  specialLinkUses   SpecialLinkUse[]
  payables          Payable[]
  productBarcodes   ProductBarcode[]
  comandas          Comanda[]
  recipeMaterials   RecipeMaterial[]
  materialMovements RecipeMaterialMovement[]
  recipes           Recipe[]
  discountRequests  DiscountRequest[]
  saleReturns       SaleReturn[]
  featureUsage      FeatureUsage[]
  ownerWithdrawals  OwnerWithdrawal[]
  loans             Loan[]
  balanceSnapshots  BalanceSnapshot[]
  logo              BusinessLogo?
  /// Cuándo se cambió el logo (null = sin logo). Sirve para saber si hay y para que el navegador no muestre uno viejo.
  logoUpdatedAt     DateTime?
  /// Código para el enlace "Invita a un amigo" (se crea la primera vez que se abre esa página).
  referralCode      String?                  @unique

  @@map("business")
}

model BusinessMember {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role     @default(EMPLOYEE)
  /// Meta de ventas del mes y comisión (% sobre lo que vende, menos devoluciones). Null = sin meta / sin comisión.
  monthlyGoal    Int?
  commissionRate Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_member")
}

model BusinessSettings {
  id                    String        @id @default(cuid())
  businessId            String        @unique
  business              Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  easyMode              Boolean       @default(false)
  lowStockAlerts        Boolean       @default(true)
  noSalesReminder       Boolean       @default(true)
  weeklySummary         Boolean       @default(true)
  defaultPayment        PaymentMethod @default(CASH)
  /// El negocio cobra IVA en sus ventas (inscrito en el SII): se calcula el IVA a pagar y los montos sin IVA.
  /// Viene activado; quien no cobra IVA lo desactiva en Configuración.
  chargesVat            Boolean       @default(true)
  /// Día del mes siguiente en que vence el pago del IVA (en Chile, F29: día 20 con documentos electrónicos, si no día 12).
  vatDueDay             Int           @default(20)
  /// Tasa del pago provisional mensual (PPM) que va en el mismo F29, sobre las ventas sin IVA. 0 = no mostrarlo.
  /// Pro Pyme General 0,125% (rebaja transitoria 2025-2027, Ley 21.755); Pro Pyme Transparente 0,2%.
  ppmRate               Float         @default(0.00125)
  /// Lo que el dueño quiere sacar al mes como su sueldo (para avisar si se pasa). Null = sin meta.
  ownerSalary           Int?
  /// Plata en caja y banco que el dueño declaró, y cuándo: desde ahí el balance la sigue sola.
  openingCash           Int?
  openingCashAt         DateTime?
  /// Últimos avisos enviados por correo (para no repetirlos).
  lastWeeklySummaryAt   DateTime?
  lastNoSalesReminderAt DateTime?
  lastLowStockAlertAt   DateTime?
  /// Productos incluidos en el último aviso de stock bajo: si no cambian, no se repite el correo.
  lowStockAlertKey      String?
  /// Aviso de productos por vencer (los próximos 7 días); qué se avisó y cuándo, para no repetir cada día.
  expiryAlerts          Boolean       @default(true)
  expiryAlertKey        String?
  lastExpiryAlertAt     DateTime?
  /// Fiado: plazo de pago (días) y aviso al dueño de los clientes que se pasaron. Qué se avisó y cuándo, para no repetir.
  fiadoDays             Int           @default(15)
  fiadoReminders        Boolean       @default(true)
  fiadoReminderKey      String?
  /// Reserva tu hora (negocios de servicios): horario por día [lun..dom] {open,close} o null si cierra,
  /// cada cuánto se ofrecen horas, con cuánta anticipación mínima y hasta cuántos días adelante.
  bookingEnabled        Boolean       @default(true)
  bookingHours          Json?
  bookingSlotMin        Int           @default(30)
  bookingMinNoticeMin   Int           @default(60)
  bookingMaxDays        Int           @default(30)
  lastFiadoReminderAt   DateTime?
  /// Negocios de comida: cuántas mesas tiene (Mesa 1…N) y lugares con nombre propio (Barra, Terraza, Para llevar…).
  tableCount            Int           @default(6)
  tableExtras           String[]      @default(["Para llevar", "Delivery"])
  /// Los empleados solo venden productos guardados (sin venta rápida ni productos escritos a mano): así todo descuento pasa por aprobación.
  employeesProductsOnly Boolean       @default(true)
  /// Datos del negocio que salen en las cotizaciones (y en otros documentos para el cliente).
  taxId                 String?
  address               String?
  contactPhone          String?
  contactEmail          String?
  /// Condiciones que van al pie de cada cotización (forma de pago, plazo de entrega…).
  quoteTerms            String?
  /// Cuántos días vale una cotización nueva.
  quoteValidDays        Int           @default(15)
  /// Tarjeta de fidelidad (plan Pro): sellos (una compra, un sello) o puntos (según lo que se compra).
  loyaltyEnabled        Boolean       @default(false)
  loyaltyMode           LoyaltyMode   @default(STAMPS)
  /// Sellos o puntos que se necesitan para el premio.
  loyaltyGoal           Int           @default(10)
  /// El premio, en palabras del negocio ("Un café gratis", "$5.000 de descuento").
  loyaltyReward         String?
  /// Sellos: compra mínima para ganar un sello (0 = cualquier compra).
  loyaltyMinPurchase    Int           @default(0)
  /// Puntos: cuánto hay que comprar para ganar un punto.
  loyaltyPointValue     Int           @default(1000)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("business_settings")
}

// ─── Catálogo ───────────────────────────────────────────────────────────────

model Category {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, name])
  @@map("category")
}

model Product {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cost        Int       @default(0)
  price       Int       @default(0)
  stock       Int       @default(0)
  minStock    Int       @default(0)
  trackStock  Boolean   @default(true)
  /// Foto del producto (Vercel Blob, ya achicada en el celular). Se muestra en la tienda online, al vender y en Productos.
  imageUrl    String?
  /// Próximo vencimiento del stock (para avisar lo que está por vencer).
  expiresAt   DateTime?
  /// Servicio (corte, consulta, clase…): no lleva stock, se agenda y se reserva. Los productos son lo demás.
  isService   Boolean   @default(false)
  /// Servicios: cuánto dura (minutos), para la Agenda.
  durationMin Int?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  saleItems SaleItem[]
  movements InventoryMovement[]
  /// Códigos de barras adicionales (el principal es `sku`).
  barcodes  ProductBarcode[]

  comandaItems ComandaItem[]
  /// Recetas que fijan el precio y el costo de este producto.
  recipes      Recipe[]
  appointments Appointment[]

  @@unique([businessId, sku])
  @@index([businessId, active])
  @@index([categoryId])
  @@map("product")
}

// ─── Ventas ─────────────────────────────────────────────────────────────────

model Sale {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date          DateTime      @default(now())
  total         Int
  paymentMethod PaymentMethod @default(CASH)
  isQuick       Boolean       @default(false)
  note          String?
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  /// Id que pone el teléfono: si la venta se guardó sin internet y se reintenta, no se duplica.
  clientId      String?

  items             SaleItem[]
  movements         InventoryMovement[]
  /// Materiales de recetas que se descontaron con esta venta.
  materialMovements RecipeMaterialMovement[]
  comanda           Comanda?
  /// Descuento sobre el total de los productos (el total ya lo tiene restado). Quién lo pidió y aprobó: discountRequest.
  discount          Int                      @default(0)
  /// Propina (restaurantes). No es venta del negocio: va aparte del total, pero si fue en efectivo está en la caja.
  tip               Int                      @default(0)
  discountRequest   DiscountRequest?
  /// Si esta venta es una devolución (venta en negativo), la venta original.
  returnOfId        String?
  returnOf          Sale?                    @relation("SaleReturnOf", fields: [returnOfId], references: [id], onDelete: SetNull)
  returnedBy        Sale[]                   @relation("SaleReturnOf")
  returnRequests    SaleReturn[]             @relation("ReturnRequests")
  returnRecord      SaleReturn?              @relation("ReturnSale")
  /// Descuento de promociones automáticas (2×1, %…) y cupones; el total ya lo tiene restado. Detalle en `promotions`.
  promoDiscount     Int                      @default(0)
  promotions        SalePromotion[]

  @@unique([businessId, clientId])
  @@index([businessId, date])
  @@index([customerId])
  @@map("sale")
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Int
  unitPrice   Int
  unitCost    Int      @default(0)
  subtotal    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
  @@map("sale_item")
}

// ─── Gastos ─────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  icon       String?
  isDefault  Boolean   @default(false)
  // Gasto que crece con las ventas (compra de mercadería). El resto se trata como gasto fijo.
  isVariable Boolean   @default(false)
  expenses   Expense[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, name])
  @@map("expense_category")
}

model Expense {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  description String
  amount      Int
  /// Tiene factura a nombre del negocio: su IVA se descuenta del IVA a pagar.
  hasInvoice  Boolean          @default(false)
  /// Impuestos específicos que trae la factura aparte del IVA (ILA de bebidas, impuesto a los combustibles…).
  /// No son IVA: no se descuentan del IVA a pagar y quedan como parte del costo.
  specificTax Int              @default(0)
  /// Retención de la boleta de honorarios que paga el negocio en el F29 (calculada con la tasa del año del gasto).
  withholding Int              @default(0)
  date        DateTime         @default(now())
  categoryId  String?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId  String?
  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([businessId, date])
  @@index([supplierId])
  @@index([categoryId])
  @@map("expense")
}

// ─── Contactos ──────────────────────────────────────────────────────────────

model Customer {
  id           String            @id @default(cuid())
  businessId   String
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  email        String?
  notes        String?
  sales        Sale[]
  payments     CustomerPayment[]
  appointments Appointment[]
  quotes       Quote[]
  loyaltyCard  LoyaltyCard?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([businessId])
  @@map("customer")
}

model Supplier {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  email        String?
  products     String?
  deliveryCost Int?
  notes        String?
  expenses     Expense[]
  payables     Payable[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([businessId])
  @@map("supplier")
}

// ─── Inventario ─────────────────────────────────────────────────────────────

model InventoryMovement {
  id          String                @id @default(cuid())
  businessId  String
  business    Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId   String
  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        InventoryMovementType
  // Positivo suma stock, negativo resta.
  quantity    Int
  /// Costo unitario del producto al momento del movimiento (para valorizar la merma).
  unitCost    Int                   @default(0)
  reason      String?
  saleId      String?
  sale        Sale?                 @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([businessId, productId])
  @@index([saleId])
  @@index([productId])
  @@map("inventory_movement")
}

// ─── Metas y notificaciones ─────────────────────────────────────────────────

model Goal {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Mes de la meta en formato AAAA-MM, en la zona horaria del negocio.
  month        String
  targetProfit Int
  marginPct    Float?
  fixedCosts   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, month])
  @@map("goal")
}

model Notification {
  id         String           @id @default(cuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([businessId, readAt])
  @@map("notification")
}

// ─── Límite de intentos (Better Auth) ───────────────────────────────────────
// Se guarda en la base de datos para que funcione aunque Vercel use varias copias del servidor.

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ─── Fiado: abonos de clientes ──────────────────────────────────────────────
// Saldo de un cliente = ventas FIADO − abonos.

model CustomerPayment {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount        Int
  date          DateTime      @default(now())
  paymentMethod PaymentMethod @default(CASH)
  note          String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([businessId, date])
  @@index([customerId])
  @@map("customer_payment")
}

// ─── Cierre de caja ─────────────────────────────────────────────────────────

model CashClosing {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Día del cierre (AAAA-MM-DD) en la zona horaria del negocio.
  day         String
  opening     Int
  cashSales   Int
  cashIn      Int
  cashOut     Int
  expected    Int
  counted     Int
  difference  Int
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, day])
  @@map("cash_closing")
}

/// Celular o computador donde la persona activó los avisos (Web Push). Si el navegador la da de baja, se borra.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Para mostrar "Este celular · Android" en la lista.
  device    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscription")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  DONE
  NO_SHOW
  CANCELLED
}

/// Cita de la Agenda (peluquerías, consultas, talleres…). Al cobrarla se vuelve una venta.
model Appointment {
  id            String            @id @default(cuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  productId     String?
  product       Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Nombre y precio del servicio al agendar (si después cambia el precio, la cita conserva el suyo).
  serviceName   String
  price         Int
  /// Quién atiende (alguien del equipo). Vacío = cualquiera.
  staffId       String?
  staff         User?             @relation("AppointmentStaff", fields: [staffId], references: [id], onDelete: SetNull)
  startAt       DateTime
  endAt         DateTime
  status        AppointmentStatus @default(SCHEDULED)
  note          String?
  saleId        String?           @unique
  createdById   String?
  remindedAt    DateTime?
  /// APP (la agendó el negocio) u ONLINE (la reservó el cliente en la página del negocio).
  source        String            @default("APP")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([businessId, startAt])
  @@index([staffId, startAt])
  @@map("appointment")
}

enum PromotionKind {
  PERCENT
  BUY_X_PAY_Y
}

/// Promoción automática: se aplica sola al vender, en las comandas y en la tienda online si se cumplen sus condiciones.
model Promotion {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  kind       PromotionKind
  /// PERCENT: cuánto % se descuenta.
  percent    Int?
  /// BUY_X_PAY_Y: lleva X, paga Y (2×1 = lleva 2 paga 1).
  buyQty     Int?
  payQty     Int?
  /// ALL (todo), PRODUCTS (los de productIds) o CATEGORY (los de categoryId).
  scope      String        @default("ALL")
  productIds String[]      @default([])
  categoryId String?
  startsAt   DateTime?
  endsAt     DateTime?
  /// Días de la semana (0 = domingo). Vacío = todos los días.
  weekdays   Int[]         @default([])
  /// Horario (minutos desde las 00:00, hora del negocio). Vacío = todo el día. Sirve para el happy hour.
  fromMinute Int?
  toMinute   Int?
  /// Dónde se aplica: al vender en el local (ventas y comandas) y en la tienda online.
  inStore    Boolean       @default(true)
  online     Boolean       @default(true)
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  sales SalePromotion[]

  @@index([businessId, active])
  @@map("promotion")
}

/// Cuánto descontó cada promoción en cada venta (para los reportes).
model SalePromotion {
  id          String     @id @default(cuid())
  saleId      String
  sale        Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  name        String
  amount      Int

  @@index([saleId])
  @@index([promotionId])
  @@map("sale_promotion")
}

/// Cupón de un negocio para su tienda online: el cliente escribe el código al hacer el pedido.
/// (Distinto de Coupon, que son los códigos de descuento del plan de OrdenSimple.)
model StoreCoupon {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code       String
  percent    Int?
  amount     Int?
  minTotal   Int       @default(0)
  maxUses    Int?
  uses       Int       @default(0)
  endsAt     DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, code])
  @@map("store_coupon")
}

enum WebOrderStatus {
  NEW
  DONE
  CANCELLED
}

/// En qué va el pedido, para el cliente (lo ve en el enlace de seguimiento).
enum WebOrderStage {
  RECEIVED
  PREPARING
  READY
  DELIVERED
}

/// Pedido hecho desde la tienda online. Los precios se toman del sistema al pedir; al aceptarlo se vuelve venta o comanda.
model WebOrder {
  id            String         @id @default(cuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String?
  /// Para enviarle la confirmación y el enlace de seguimiento (opcional).
  customerEmail String?
  /// "Retiro en el local" o "Despacho" (con la dirección en la nota).
  delivery      Boolean        @default(false)
  /// Mesa desde la que se pidió con la carta QR (restaurantes). Null: pedido normal.
  table         String?
  note          String?
  /// [{ productId, name, quantity, unitPrice }]
  items         Json
  total         Int
  status        WebOrderStatus @default(NEW)
  saleId        String?
  comandaId     String?
  handledById   String?
  handledAt     DateTime?
  createdAt     DateTime       @default(now())

  /// Promociones y cupón del pedido (el total ya los tiene restados).
  promoDiscount  Int     @default(0)
  /// [{ promotionId, name, amount }]
  promos         Json?
  couponCode     String?
  couponDiscount Int     @default(0)

  /// Enlace de seguimiento (/pedido/<trackToken>): el cliente ve en qué va su pedido sin preguntar.
  trackToken      String        @unique
  stage           WebOrderStage @default(RECEIVED)
  /// Cuándo pasó a cada etapa: { PREPARING: iso, READY: iso, DELIVERED: iso }.
  stageTimes      Json?
  /// Hay que pagarlo online antes de atenderlo (según lo que eligió el negocio): mientras no se pague, espera aparte.
  paymentRequired Boolean       @default(false)

  @@index([businessId, status, createdAt])
  @@map("web_order")
}

enum LoyaltyMode {
  STAMPS
  POINTS
}

enum LoyaltyMovementKind {
  EARN
  REDEEM
  ADJUST
}

/// Tarjeta de fidelidad de un cliente. Se comparte con un enlace (/tarjeta/<token>) que el cliente guarda en su celular.
model LoyaltyCard {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String            @unique
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String            @unique
  /// Sellos o puntos que tiene ahora.
  balance    Int               @default(0)
  /// Premios que ya canjeó.
  rewards    Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  movements  LoyaltyMovement[]

  @@index([businessId, updatedAt])
  @@map("loyalty_card")
}

/// Cada sello o punto que se suma o se descuenta (por una venta, un canje o a mano).
model LoyaltyMovement {
  id          String              @id @default(cuid())
  cardId      String
  card        LoyaltyCard         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  kind        LoyaltyMovementKind
  /// Positivo suma, negativo resta.
  amount      Int
  /// Venta que lo generó (si la venta se elimina, se descuenta).
  saleId      String?
  note        String?
  createdById String?
  createdAt   DateTime            @default(now())

  @@index([cardId, createdAt])
  @@index([saleId])
  @@map("loyalty_movement")
}

/// Cuenta de Mercado Pago que el negocio conectó para cobrar online (OAuth). Las claves van cifradas.
model MercadoPagoAccount {
  id            String       @id @default(cuid())
  businessId    String       @unique
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Id de la cuenta en Mercado Pago.
  mpUserId      String
  accessToken   String
  refreshToken  String?
  publicKey     String?
  expiresAt     DateTime
  liveMode      Boolean      @default(true)
  /// Cobrar online en la tienda (si no, se paga al retirar o recibir).
  storeEnabled  Boolean      @default(false)
  /// Cuándo es obligatorio pagar online en la tienda (lo decide el dueño).
  storePayRule  StorePayRule @default(ALL)
  connectedById String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("mercado_pago_account")
}

/// Qué se paga online en la tienda (lo fija el dueño; el cliente no elige). ALL: todo, al pedir. DELIVERY: los despachos al pedir; los retiros, al retirar.
enum StorePayRule {
  ALL
  DELIVERY
}

enum OnlinePaymentKind {
  WEB_ORDER
  QUOTE
  LINK
}

enum OnlinePaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

/// Un cobro online: el cliente paga con Mercado Pago, el dinero va a la cuenta del negocio y OrdenSimple recibe su comisión.
model OnlinePayment {
  id           String              @id @default(cuid())
  businessId   String
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind         OnlinePaymentKind
  webOrderId   String?
  quoteId      String?
  linkId       String?
  description  String
  amount       Int
  /// Comisión de OrdenSimple.
  fee          Int
  status       OnlinePaymentStatus @default(PENDING)
  preferenceId String?
  mpPaymentId  String?             @unique
  /// credit_card, debit_card, account_money…
  method       String?
  paidAt       DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([businessId, createdAt])
  @@index([webOrderId])
  @@index([quoteId])
  @@index([linkId])
  @@map("online_payment")
}

enum PaymentLinkStatus {
  ACTIVE
  PAID
  CANCELLED
}

/// Enlace de pago: el negocio cobra un monto y lo envía por WhatsApp (/cobro/<token>).
model PaymentLink {
  id            String            @id @default(cuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  token         String            @unique
  title         String
  amount        Int
  customerName  String?
  customerPhone String?
  /// Enlace para cobrar el fiado de un cliente: al pagarse queda como abono a su cuenta (no como venta nueva).
  customerId    String?
  forDebt       Boolean           @default(false)
  status        PaymentLinkStatus @default(ACTIVE)
  /// Venta que se registró al pagarse.
  saleId        String?
  createdById   String?
  paidAt        DateTime?
  createdAt     DateTime          @default(now())

  @@index([businessId, createdAt])
  @@map("payment_link")
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  SOLD
}

/// Cotización para un cliente: se comparte con un enlace (/cotizacion/<token>) donde la puede aceptar o rechazar.
/// Los precios quedan fijos al cotizar; al venderla se vuelve una venta con esos mismos precios.
model Quote {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Correlativo del negocio (Cotización N.º 1, 2, 3…).
  number        Int
  token         String      @unique
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  customerEmail String?
  /// [{ productId, description, quantity, unitPrice }]
  items         Json
  subtotal      Int
  discount      Int         @default(0)
  total         Int
  note          String?
  validUntil    DateTime
  status        QuoteStatus @default(PENDING)
  /// Cuándo la abrió el cliente por primera vez.
  viewedAt      DateTime?
  respondedAt   DateTime?
  saleId        String?
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([businessId, number])
  @@index([businessId, status, createdAt])
  @@map("quote")
}

/// Turno de caja (mañana, tarde…): quien abre deja el sencillo y al cerrar cuenta el efectivo.
/// Cuenta lo que pasó entre openedAt y closedAt. Hay un solo turno abierto a la vez por negocio.
model CashShift {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  openedById String?
  openedBy   User?     @relation("ShiftOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  openedAt   DateTime  @default(now())
  opening    Int
  closedById String?
  closedBy   User?     @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt   DateTime?
  salesTotal Int       @default(0)
  salesCount Int       @default(0)
  cashSales  Int       @default(0)
  cashIn     Int       @default(0)
  cashOut    Int       @default(0)
  expected   Int       @default(0)
  counted    Int?
  difference Int?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([businessId, openedAt])
  @@map("cash_shift")
}

// ─── Registro de errores (se ve en /admin) ──────────────────────────────────

model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  digest    String?
  path      String?
  method    String?
  stack     String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("error_log")
}

// ─── Códigos de descuento (los crea el administrador en /admin) ─────────────

enum CouponKind {
  FREE_DAYS // Regala días de un plan
  PERCENT // Descuento porcentual en la suscripción
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  kind           CouponKind
  plan           Plan       @default(PRO)
  days           Int?
  percentOff     Int?
  maxRedemptions Int?
  expiresAt      DateTime?
  active         Boolean    @default(true)
  note           String?
  createdBy      String?
  createdAt      DateTime   @default(now())

  redemptions CouponRedemption[]

  @@map("coupon")
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  createdAt  DateTime @default(now())

  @@unique([couponId, businessId])
  @@index([businessId])
  @@map("coupon_redemption")
}

// ─── Correos de promoción (los envía el administrador en /admin) ─────────────

model EmailCampaign {
  id          String    @id @default(cuid())
  subject     String
  body        String
  buttonLabel String?
  buttonUrl   String?
  couponCode  String?
  /// ALL, FREE, PAID o DIRECT (personas específicas).
  audience    String    @default("ALL")
  /// Rubros a los que se envió (vacío: todos los rubros).
  rubros      String[]  @default([])
  recipients  Int       @default(0)
  /// En los envíos a personas específicas: sus correos, separados por coma.
  toEmails    String?
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  createdBy   String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  @@map("email_campaign")
}

// ─── Invitaciones al equipo de un negocio ───────────────────────────────────

model Invitation {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email       String
  role        Role      @default(EMPLOYEE)
  token       String    @unique
  invitedById String?
  /// Invitaciones enviadas juntas (una por sucursal): se aceptan todas con un solo enlace.
  batchId     String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId])
  @@index([email])
  @@index([batchId])
  @@map("invitation")
}

// ─── Suscripciones pagadas (Mercado Pago) ──────────────────────────────────

model Subscription {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Quién se suscribió.
  userId          String?
  plan            Plan      @default(PRO)
  provider        String    @default("MERCADOPAGO")
  /// Id de la suscripción en Mercado Pago (preapproval).
  externalId      String    @unique
  /// pending, authorized, paused o cancelled (como los informa Mercado Pago).
  status          String
  /// Monto mensual, en la unidad mínima de la moneda.
  amount          Int
  currency        String    @default("CLP")
  payerEmail      String
  /// Enlace para completar el pago mientras está pendiente.
  checkoutUrl     String?
  lastChargedAt   DateTime?
  nextPaymentAt   DateTime?
  /// "Invita a un amigo": el cobro está pausado como regalo y se reanuda solo en esta fecha.
  giftPausedUntil DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([businessId])
  @@map("subscription")
}

// ─── Pagos pendientes a proveedores (cuentas por pagar) ─────────────────────

model Payable {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  description String
  amount      Int
  /// Hasta cuándo hay que pagar.
  dueDate     DateTime
  /// Es una factura a nombre del negocio: su IVA se descuenta en el mes de la factura (no en el del pago).
  hasInvoice  Boolean   @default(true)
  /// Fecha de la factura. Al pagarla, el gasto queda en esta fecha.
  invoiceDate DateTime?
  /// Cuándo se pagó (se registra también como gasto).
  paidAt      DateTime?
  expenseId   String?
  /// Último recordatorio enviado por correo (para no repetirlo el mismo día).
  remindedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId, paidAt, dueDate])
  @@index([supplierId])
  @@map("payable")
}

// ─── Varios códigos de barras para un mismo producto ───────────────────────

model ProductBarcode {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  code       String
  createdAt  DateTime @default(now())

  @@unique([businessId, code])
  @@index([productId])
  @@map("product_barcode")
}

/// Notas internas del administrador sobre un usuario (solo las ve el admin).
model AdminNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Correo del administrador que la escribió.
  author    String
  text      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("admin_note")
}

/// Uso de funciones que no dejan registro propio (ver flujo de caja, escanear…): una fila por negocio, función y día.
model FeatureUsage {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  feature    String
  /// Día "AAAA-MM-DD" en la zona horaria del negocio.
  day        String
  count      Int      @default(1)

  @@id([businessId, feature, day])
  @@index([feature, day])
  @@map("feature_usage")
}

/// Plata o productos que el dueño saca del negocio para él. No es un gasto: no baja la utilidad.
model OwnerWithdrawal {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Monto en plata; si son productos, lo que costaron.
  amount      Int
  date        DateTime
  /// De dónde salió la plata: CASH (caja) o BANK (banco). Los productos salen del stock.
  source      String   @default("CASH")
  /// MONEY (saca plata), GOODS (saca productos) o DEPOSIT (pone plata en el negocio: ahorros, un préstamo, sencillo).
  kind        String   @default("MONEY")
  productId   String?
  quantity    Int?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([businessId, date])
  @@map("owner_withdrawal")
}

/// Préstamos y deudas del negocio (banco, tarjeta, familiares): lo que se debe hoy.
model Loan {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lender      String
  /// Lo que se debe hoy.
  balance     Int
  /// Cuota mensual (opcional) y día del mes en que se paga.
  installment Int?
  dueDay      Int?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
  @@map("loan")
}

/// Foto del balance de cada mes (la última vez que se miró ese mes), para ver cómo cambia.
model BalanceSnapshot {
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// "AAAA-MM"
  month       String
  assets      Int
  liabilities Int
  updatedAt   DateTime @updatedAt

  @@id([businessId, month])
  @@map("balance_snapshot")
}

/// Logo del negocio, ya achicado en el navegador (máximo 256 px). Va aparte para no cargarlo con cada consulta del negocio.
model BusinessLogo {
  businessId String   @id
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  data       Bytes
  type       String
  updatedAt  DateTime @updatedAt

  @@map("business_logo")
}

/// Foto de perfil, ya achicada en el navegador (máximo 256 px). User.image guarda su dirección.
model UserPhoto {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  type      String
  updatedAt DateTime @updatedAt

  @@map("user_photo")
}

// ─── Invita a un amigo ──────────────────────────────────────────────────────

/// Reglas del programa (una sola fila, id "default"); se cambian en /admin.
model ReferralProgram {
  id              String   @id @default("default")
  enabled         Boolean  @default(true)
  /// Plan que se regala.
  plan            Plan     @default(PRO)
  /// Días para quien llega invitado (al crear su negocio).
  invitedDays     Int      @default(14)
  /// Días para quien invita.
  referrerDays    Int      @default(30)
  /// Cuándo gana quien invita: REGISTRO (al crear el negocio), VENTAS (al registrar minSales ventas) o PAGO (al pagar su primer mes).
  referrerTrigger String   @default("VENTAS")
  minSales        Int      @default(5)
  /// Máximo de recompensas por negocio que invita (vacío = sin límite).
  maxRewards      Int?     @default(12)
  updatedAt       DateTime @updatedAt

  @@map("referral_program")
}

/// Un negocio que llegó invitado por otro.
model Referral {
  id                 String    @id @default(cuid())
  referrerBusinessId String
  referrer           Business  @relation("ReferralReferrer", fields: [referrerBusinessId], references: [id], onDelete: Cascade)
  referredBusinessId String    @unique
  referred           Business  @relation("ReferralReferred", fields: [referredBusinessId], references: [id], onDelete: Cascade)
  referredUserId     String?
  /// Días que recibió el invitado (0 si no se pudo aplicar) y por qué.
  invitedDays        Int       @default(0)
  invitedNote        String?
  /// Cuándo ganó quien invitó, cuántos días y una nota (por ejemplo, si ya tenía un plan mayor).
  referrerRewardedAt DateTime?
  referrerDays       Int?
  referrerNote       String?
  createdAt          DateTime  @default(now())

  @@index([referrerBusinessId])
  @@map("referral")
}

/// Enlace especial que crea el administrador para una campaña (anuncios, ferias, un contador aliado...):
/// ordensimple.cl/amigo/<code>. Quien se registra con él recibe días de regalo al crear su negocio.
model SpecialLink {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  plan      Plan             @default(PRO)
  days      Int              @default(14)
  expiresAt DateTime?
  maxUses   Int?
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  uses      SpecialLinkUse[]

  @@map("special_link")
}

/// Un negocio que se creó con un enlace especial.
model SpecialLinkUse {
  id         String      @id @default(cuid())
  linkId     String
  link       SpecialLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  /// Días que recibió (0 si no se pudo aplicar) y por qué.
  days       Int         @default(0)
  note       String?
  createdAt  DateTime    @default(now())

  @@unique([linkId, businessId])
  @@index([businessId])
  @@map("special_link_use")
}

/// Datos del segundo paso al iniciar sesión (app de códigos y códigos de respaldo). Lo maneja Better Auth.
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

/// Administradores agregados desde el panel (además de los de ADMIN_EMAILS en Vercel, que son los dueños).
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  addedBy   String?
  createdAt DateTime @default(now())

  @@map("admin_user")
}

// ─── Comandas (restaurantes, cafés y comida) ────────────────────────────────

enum ComandaStatus {
  OPEN
  PAID
  CANCELLED
}

/// Cuenta abierta de una mesa o pedido. Al cobrarla se crea una venta normal (saleId).
model Comanda {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  label       String
  status      ComandaStatus @default(OPEN)
  saleId      String?       @unique
  sale        Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdById String?
  closedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items ComandaItem[]

  @@index([businessId, status])
  @@map("comanda")
}

model ComandaItem {
  id          String    @id @default(cuid())
  comandaId   String
  comanda     Comanda   @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Int
  unitPrice   Int
  /// "sin mayo", "para llevar"…
  note        String?
  /// Cuántas se enviaron a la cocina (lo que se agrega después espera a que el garzón lo envíe).
  sentQty     Int       @default(0)
  /// Cuándo se envió a la cocina por última vez (la cocina ordena y avisa según esto).
  sentAt      DateTime?
  /// Cuántas de estas ya marcó la cocina como listas (si agregan más, lo nuevo vuelve a la cocina).
  readyQty    Int       @default(0)
  /// Cuántas ya se pagaron (cuando cada uno paga lo suyo). Lo que falta cobrar es quantity - paidQty.
  paidQty     Int       @default(0)
  /// De quién es (Persona 1, 2, 3…), para separar la cuenta. Null: sin persona o para compartir.
  person      Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([comandaId])
  @@index([productId])
  @@map("comanda_item")
}

// ─── Descuentos con aprobación ──────────────────────────────────────────────

enum DiscountStatus {
  PENDING
  APPROVED
  REJECTED
  USED
}

/// Descuento que pide un trabajador y aprueba (o rechaza) el dueño o un administrador.
/// Si lo aplica directamente el dueño o un administrador, se guarda ya aprobado por él mismo.
model DiscountRequest {
  id              String         @id @default(cuid())
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedById   String
  requestedByName String
  /// Monto del descuento y total de los productos sobre el que se pidió.
  amount          Int
  subtotal        Int
  reason          String
  /// Dónde se pidió: "Mesa 4", "Venta"...
  context         String
  status          DiscountStatus @default(PENDING)
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  saleId          String?        @unique
  sale            Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([businessId, status])
  @@map("discount_request")
}

// ─── Devoluciones ───────────────────────────────────────────────────────────

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Devolución de una venta: la pide un trabajador y la aprueba el dueño o un administrador (o la hacen ellos directo).
/// Al aprobarse se registra como una venta en negativo (returnSaleId) el día en que se devuelve.
model SaleReturn {
  id              String        @id @default(cuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleId          String
  sale            Sale          @relation("ReturnRequests", fields: [saleId], references: [id], onDelete: Cascade)
  returnSaleId    String?       @unique
  returnSale      Sale?         @relation("ReturnSale", fields: [returnSaleId], references: [id], onDelete: SetNull)
  /// [{ saleItemId, productId, description, quantity, unitPrice }]
  items           Json
  amount          Int
  reason          String
  /// Cómo se devuelve la plata (FIADO = se rebaja de lo que debe el cliente).
  refundMethod    PaymentMethod
  /// true: el producto vuelve al stock; false: viene dañado y se anota como merma.
  restock         Boolean
  status          ReturnStatus  @default(PENDING)
  requestedById   String
  requestedByName String
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([businessId, status])
  @@index([saleId])
  @@map("sale_return")
}

// ─── Recetas ────────────────────────────────────────────────────────────────

/// Material o insumo de las recetas (harina, levadura, aceite…): lo que trae el paquete que compras, su precio y cuánto tienes.
model RecipeMaterial {
  id         String                   @id @default(cuid())
  businessId String
  business   Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  /// Medida: g, kg, ml, l o u (unidades).
  unit       String
  /// Cuánto trae el paquete que compras, en `unit`.
  packQty    Float
  /// Lo que pagas por ese paquete.
  packPrice  Int
  /// Cuánto tienes ahora, en `unit`. Null: no se lleva la cuenta.
  stock      Float?
  /// Cuándo vence lo que tienes (para avisar antes y mostrarlo en Inventario).
  expiresAt  DateTime?
  items      RecipeItem[]
  movements  RecipeMaterialMovement[]
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@unique([businessId, name])
  @@map("recipe_material")
}

/// Receta: sus ingredientes, cuánto rinde y con qué márgenes se calcula el precio de venta por unidad.
model Recipe {
  id          String       @id @default(cuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  /// Cuántas unidades salen de la receta.
  yieldUnits  Int          @default(1)
  /// Porcentaje adicional sobre el costo (mano de obra, gas, luz…).
  overheadPct Float        @default(0)
  /// Porcentaje de ganancia sobre el costo total.
  profitPct   Float        @default(0)
  /// Producto del catálogo al que se le pasó el precio y el costo.
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  items       RecipeItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([businessId, name])
  @@map("recipe")
}

model RecipeItem {
  id         String         @id @default(cuid())
  recipeId   String
  recipe     Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  materialId String
  /// Si se borra el material, se quita de las recetas.
  material   RecipeMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantity   Float
  /// Medida en que se anotó (compatible con la del material: g/kg, ml/l o u).
  unit       String

  @@index([recipeId])
  @@index([materialId])
  @@map("recipe_item")
}

/// Lo que se descontó (o devolvió) del stock de un material por una venta de un producto hecho con receta.
model RecipeMaterialMovement {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  materialId String
  material   RecipeMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  /// En la medida del material: negativo si se descontó.
  quantity   Float
  reason     String
  /// Venta que lo descontó (para devolverlo si la venta se edita o se elimina).
  saleId     String?
  sale       Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())

  @@index([saleId])
  @@index([materialId, createdAt])
  @@map("recipe_material_movement")
}

// ─── Códigos de activación (Pro permanente, vendido en Mercado Libre) ───────

enum ActivationCodeStatus {
  AVAILABLE // Disponible: nadie lo tiene
  RESERVED // Reservado: asignado a una venta o entregado a mano, todavía sin canjear
  USED // Usado: canjeado por una cuenta
  VOID // Anulado
}

model ActivationCode {
  id               String               @id @default(cuid())
  /// OS-PRO-XXXX-XXXX
  code             String               @unique
  /// Por ahora solo "pro_permanente".
  kind             String               @default("pro_permanente")
  plan             Plan                 @default(PRO)
  status           ActivationCodeStatus @default(AVAILABLE)
  note             String?
  createdBy        String?
  createdAt        DateTime             @default(now())
  reservedAt       DateTime?
  /// Cuándo se le hizo llegar al comprador (mensaje de Mercado Libre o entrega a mano).
  sentAt           DateTime?
  redeemedAt       DateTime?
  voidedAt         DateTime?
  redeemedByUserId String?
  redeemedByEmail  String?
  /// Negocio desde donde se canjeó.
  businessId       String?
  /// Venta de Mercado Libre y unidad de esa venta (1, 2, 3...) a la que se asignó.
  mlOrderId        String?
  mlUnit           Int?
  sendAttempts     Int                  @default(0)
  lastError        String?
  /// Mientras se está enviando el mensaje (para no enviarlo dos veces si llegan dos avisos a la vez).
  sendingUntil     DateTime?

  @@unique([mlOrderId, mlUnit])
  @@index([status, createdAt])
  @@map("activation_code")
}

/// Ventas de Mercado Libre del Pro permanente.
model MlOrder {
  /// Id de la orden en Mercado Libre.
  id           String   @id
  /// Pack de la orden (para la mensajería); si no tiene, es el mismo id de la orden.
  packId       String
  buyerId      String?
  buyerNick    String?
  /// Estado de la orden en Mercado Libre (paid, cancelled...).
  status       String
  paid         Boolean  @default(false)
  /// Unidades compradas del Pro permanente.
  units        Int      @default(0)
  /// Unidades pagadas que todavía no tienen código (no quedaban disponibles).
  pendingUnits Int      @default(0)
  /// Algo que revisar: venta cancelada, pago devuelto o reclamo.
  reviewReason String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("ml_order")
}

/// Cuenta de vendedor de Mercado Libre conectada (una sola).
model MercadoLibreAccount {
  id           String   @id @default("principal")
  sellerId     String
  nickname     String?
  /// Cifrados.
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  connectedBy  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("mercado_libre_account")
}

/// Registro de lo que pasa con los códigos: avisos de Mercado Libre, envíos, canjes y anulaciones.
model LicenseLog {
  id        String   @id @default(cuid())
  /// notificacion, asignado, enviado, envio_fallido, canje, anulado, generados, revisar, sin_codigos, conexion, error
  kind      String
  codeId    String?
  code      String?
  mlOrderId String?
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("license_log")
}

// ─── Tarjetas de presentación digitales ─────────────────────────────────────

/// Tarjeta de una persona (una por usuario), pública en /perfil/<slug>. El slug no cambia: así el enlace y el QR siguen
/// sirviendo aunque se editen los datos. Solo se publica lo que está en `published`.
model ContactCard {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Negocio cuyo logo se muestra.
  businessId     String?
  business       Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  slug           String    @unique
  /// Apagada: la dirección responde como si no existiera.
  active         Boolean   @default(true)
  fullName       String
  jobTitle       String?
  company        String?
  phone          String?
  whatsapp       String?
  email          String?
  website        String?
  instagram      String?
  facebook       String?
  linkedin       String?
  tiktok         String?
  x              String?
  /// Campos que la persona autorizó a mostrar. El nombre siempre se muestra.
  published      String[]  @default([])
  photo          Bytes?
  photoType      String?
  photoUpdatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([businessId])
  @@map("contact_card")
}
